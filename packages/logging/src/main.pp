fn log_trace(message: String) { say(concat("[trace] ", message)); }
fn log_debug(message: String) { say(concat("[debug] ", message)); }
fn log_info(message: String)  { say(concat("[info] ", message)); }
fn log_warn(message: String)  { say(concat("[warn] ", message)); }
fn log_error(message: String) { say(concat("[error] ", message)); }
